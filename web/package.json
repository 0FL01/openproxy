{
  "name": "openproxy",
  "version": "0.3.0",
  "description": "OpenProxy Astro dashboard sidecar",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "dev": "astro dev --port 4624",
    "dev:stack": "node scripts/run-source-stack.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "dev:bun": "bun --bun astro dev --port 4624",
    "build:bun": "bun --bun astro build",
    "preview:bun": "bun --bun astro preview"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.1",
    "@astrojs/tailwind": "^6.0.2",
    "@monaco-editor/react": "^4.7.0",
    "astro": "^5.18.1",
    "marked": "^18.0.1",
    "material-symbols": "^0.46.0",
    "monaco-editor": "^0.55.1",
    "node-machine-id": "^1.1.12",
    "prop-types": "^15.8.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "uuid": "^14.0.2",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^10",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "terser": "^5.47.1",
    "typescript": "^5.9.3"
  }
}
