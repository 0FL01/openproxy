  "legacy_data_policy": {
    "preserve_unknown_fields": true,
    "preserve_deprecated_values_on_round_trip": true,
    "destructive_read_migration": false,
    "silent_reinterpretation": false,
    "rollback_may_reenable_preserved_reader": true
  },
  "context_limit_transition": {
    "setting": "settings.providerContextLimits",
    "missing_or_empty_meaning": "default_500000_for_four_legacy_providers",
    "context_management_owner": "client",
    "proxy_memory_limit_unit": "bytes",
    "default_rejection_reader_removed_by": "C08",
    "default_rejection_reader_status": "removed",
    "explicit_count_tokens_route_preserved": true,
    "upstream_context_error_passthrough": true,
    "codex_values_are_verified_upstream_limits": false,
    "stored_values_preserved_for_rollback": true
  },
  "passthrough_policy": {
    "selection": "source_format_equals_target_format_after_dynamic_model_metadata",
    "client_identity_controls_passthrough": false,
    "standalone_cache_reanchoring": false,
    "native_messages_preconversion": false,
    "routed_model_replacement_preserved": true,
    "documented_adapter_wire_guards_preserved": true,
    "incompatible_formats_use_registered_translator": true
  },
  "generation_retry_policy": {
    "temporal_retry_owner": "client_or_harness",
    "default_executor_same_url_retries": false,
    "raw_error_status_body_and_retry_after_preserved": true,
    "distinct_configured_url_fallback_preserved": true,
    "pooled_transport_reuse_preserved": true,
    "transitional_401_403_credential_recovery": "one_attempt_pending_C13"
  },
  "versions": {
    "opencode": "1.18.31",
    "custom_harness": "unknown"
  },
  "source_registries": [
